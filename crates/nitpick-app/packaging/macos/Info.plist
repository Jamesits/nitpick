<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- package.sh sets the versions and adds LSMinimumSystemVersion. -->
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>nitpick</string>
    <!-- The identity of macOS privacy permissions (for example Screen
         Recording); changing it later resets them. -->
    <key>CFBundleIdentifier</key>
    <string>org.nitpick.nitpick</string>
    <key>CFBundleName</key>
    <string>nitpick</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0.0.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
